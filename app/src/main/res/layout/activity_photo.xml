<?xml version="1.0" encoding="utf-8"?>
<com.liudonghan.view.radius.ADConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.liudonghan.view.radius.ADImageView
        android:id="@+id/activity_add_photo_img_add"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="45dp"
        android:src="@drawable/icon_photo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:liu_round_corner="8dp" />

    <com.liudonghan.view.radius.ADTextView
        android:id="@+id/activity_add_photo_tv_one"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="ADD PROFILE PHOTO"
        android:textColor="#2e2e2e"
        android:textSize="21dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_add_photo_img_add"
        tools:ignore="HardcodedText,SpUsage" />


    <com.liudonghan.view.radius.ADEditText
        android:id="@+id/activity_input_name_edt_name"
        android:layout_width="314dp"
        android:layout_height="48dp"
        android:layout_marginTop="27dp"
        android:background="#f4f3f3"
        android:gravity="center_vertical"
        android:hint="刘冬涵"
        android:paddingStart="12dp"
        android:textColor="@color/color_342e2e"
        android:textColorHint="#777777"
        android:textSize="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_add_photo_tv_one"
        app:liu_round_corner_bottom_left="8dp"
        app:liu_round_corner_bottom_right="8dp"
        app:liu_round_corner_top_left="8dp"
        app:liu_round_corner_top_right="8dp"
        tools:ignore="HardcodedText,SpUsage" />


    <TextView
        android:id="@+id/activity_add_photo_tv_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text=" Add a profile photo so your friends know it`s you."
        android:textColor="#5c5c5c"
        android:textSize="13.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_input_name_edt_name"
        tools:ignore="HardcodedText,SpUsage" />

    <com.liudonghan.view.radius.ADButton
        android:id="@+id/activity_add_photo_btn_next"
        android:layout_width="314dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="#01a4f3"
        android:gravity="center"
        android:text="Next"
        android:textColor="@color/white"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/activity_add_photo_tv_two"
        app:liu_round_corner_bottom_left="8dp"
        app:liu_round_corner_bottom_right="8dp"
        app:liu_round_corner_top_left="8dp"
        app:liu_round_corner_top_right="8dp" />


    <com.liudonghan.view.radius.ADTextView
        android:id="@+id/activity_add_photo_tv_sign"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:text="Don't have an account? Sign up."
        android:textSize="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:ignore="HardcodedText" />


    <View
        android:layout_width="match_parent"
        android:layout_height="0.67dp"
        android:layout_above="@id/activity_add_photo_tv_sign"
        android:background="@color/color_ebebeb"
        app:layout_constraintBottom_toTopOf="@id/activity_add_photo_tv_sign" />


</com.liudonghan.view.radius.ADConstraintLayout>